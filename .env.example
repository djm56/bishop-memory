# bishop-memory — runtime configuration
#
# Copy this file to `.env` and edit locally. `.env` is git-ignored.
# All variables are read by internal/config/config.go (MustLoad).
# Defaults below are aligned with the Makefile (which is authoritative
# plan content — see README.md's "Configuration" section).

# HTTP listen interface. MustLoad composes the gin listen address as
# HTTP_HOST + ":" + PORT. 127.0.0.1 (loopback-only) is the supported
# default and matches every "locally-bound" claim in README.md and
# docs/api-contract.md. bishop-memory has NO authentication of any
# kind — every task/event endpoint is open read/write to any caller
# that can reach it, and POST /v1/documents/sync accepts a
# caller-supplied filesystem root. Changing this to 0.0.0.0 or a LAN/
# public address exposes all of that to your network; cmd/memoryd logs
# a startup warning if you do. The supported way to reach this service
# remotely is an SSH tunnel to 127.0.0.1, not a non-loopback bind.
HTTP_HOST=127.0.0.1

# HTTP listen port. MustLoad prepends ":" to compose the gin listen
# address (":8787"). The Makefile `health` target expects 8787.
PORT=8787

# SQLite database file path. Matches the Makefile `DB` variable; the
# data/ directory is created by Makefile targets init-db / reset-db.
# WAL sibling files (*-wal, *-shm) appear next to this file at runtime.
DB_PATH=data/memory.db

# Runtime mode. "development" leaves gin in debug mode (verbose logs);
# "production" switches to gin.ReleaseMode via internal/api/router.go.
APP_ENV=development

# Logging verbosity. Consumed by the standard log package; Phase 3 may
# route through slog with level filtering.
LOG_LEVEL=info
