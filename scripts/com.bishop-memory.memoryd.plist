<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  scripts/com.bishop-memory.memoryd.plist

  launchd template for the bishop-memory daemon. `install-daemon.sh`
  substitutes `__BISHOP_ROOT__` with the resolved bishop-memory path
  before installing to ~/Library/LaunchAgents/com.bishop-memory.memoryd.plist.

  Defaults (Phase 2):
    * Label:    com.bishop-memory.memoryd
    * RunAtLoad / KeepAlive:  always-on, restarted on exit
    * Program:   <BISHOP_ROOT>/bin/memoryd
    * WorkingDirectory: <BISHOP_ROOT>
    * Env:       PORT=8787, DB_PATH=data/memory.db, APP_ENV=production
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bishop-memory.memoryd</string>

    <key>ProgramArguments</key>
    <array>
        <string>__MEMORYD_BIN__</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__BISHOP_ROOT__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PORT</key>
        <string>8787</string>
        <key>DB_PATH</key>
        <string>data/memory.db</string>
        <key>APP_ENV</key>
        <string>production</string>
        <key>MEMORY_ROOT</key>
        <string>__MEMORY_ROOT__</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!--
      Log paths deliberately live OUTSIDE the checkout. launchd opens these
      files itself, before the process is spawned. When the checkout sits on
      an external/removable volume, the launchd agent context is denied
      traversal of /Volumes by TCC, that open fails, and the job dies at
      setup with EX_CONFIG (78) and no output anywhere to explain why.
      __LOG_DIR__ resolves to a path on the internal disk.
    -->
    <key>StandardOutPath</key>
    <string>__LOG_DIR__/memoryd.out.log</string>

    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/memoryd.err.log</string>
</dict>
</plist>
